# Globale BMW-Konstanten
CLIENT_ID=aabbccdd-aabb
# MQTT_USERNAME wird von der Bibliothek anscheinend nicht benötigt

# Dein lokaler MQTT-Broker
LOCAL_MQTT_URL=<hostip>
LOCAL_MQTT_PORT=1883
LOCAL_MQTT_USER=<username>
LOCAL_MQTT_PASS=<passwrod>
LOCAL_MQTT_BASETOPIC=home/bmw/live
# Setze auf true, um VIN anzuhängen (für mehrere Autos)
LOCAL_MQTT_APPEND_VIN=false

# Web-UI Port (default: 8999)
WEB_PORT=8999

# --- Datenaufbewahrung (optional, seit v1.8.9) ---
# Wie lange Telemetriewerte in der SQLite-Datenbank bleiben (Standard: 30 Tage).
TELEMETRY_RETENTION_DAYS=30
# Wie lange der Standortverlauf bleibt. 0 = unbegrenzt (Standard).
# Achtung: Der Standortverlauf ist ein vollstaendiges Bewegungsprofil.
LOCATION_RETENTION_DAYS=0
# Abstand zwischen zwei Bereinigungslaeufen in Stunden (Standard: 24).
MAINTENANCE_INTERVAL_HOURS=24

# --- Standortverlauf (optional) ---
# Seit v1.13.0 werden Breiten- und Laengengrad ueber BMWs eigenen Messzeitpunkt
# gepaart, beide Haelften muessen also aus derselben Messung stammen. 0 heisst
# exakt. Nur erhoehen, wenn das Protokoll gueltige Paare verwirft.
GPS_MAX_MEASUREMENT_DELTA=0
# Rueckfall fuer den seltenen Fall, dass BMW keinen Messzeitpunkt liefert:
# maximaler Abstand in Sekunden zwischen dem EINTREFFEN von Breiten- und
# Laengengrad (Standard: 30). Im Livebetrieb wurden bis 20,8 s beobachtet.
GPS_MAX_TIMESTAMP_DELTA=30

# --- Kartenkacheln (optional, seit v1.8.10) ---
# Die Kachel-Anfragen enthalten die Fahrzeugposition und gehen an den hier
# eingetragenen Anbieter. Standard ist OpenStreetMap. Wer das nicht moechte,
# traegt hier einen eigenen Tile-Server im Heimnetz ein.
# MAP_TILE_URL=http://192.168.1.50:8080/tiles/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=Eigener Tile-Server

# --- Protokolltiefe (optional) ---
# INFO im Dauerbetrieb, DEBUG nur zur Fehlersuche.
# Am Produktivsystem gemessen (24 Stunden, rund 33.000 Fahrzeugnachrichten):
# DEBUG macht rund 82 % des Logvolumens aus. Der Standard ist INFO, DEBUG
# also nur zeitweise setzen und danach wieder zurueckstellen.
LOG_LEVEL=INFO
# Protokolliert jede einzelne MQTT-Nachricht von BMW im Rohzustand. Nur zur
# Fehlersuche an der Datenstrecke - das Volumen ist erheblich.
# MQTT_DEBUG=false

# --- Batteriegesundheit (optional) ---
# Nennkapazitaet des Hochvoltakkus in kWh, laut Datenblatt des Fahrzeugs.
# Ohne diese Angabe wird keine Gesundheit angezeigt - geraten wird sie nicht,
# denn jedes Modell hat eine andere. Beim i5 xDrive40 sind es 81,4.
#
# Die Bridge teilt dann BMWs gestreamten Wert der nutzbaren Energie
# (batteryManagement.maxEnergy) durch diese Zahl. Gerechnet wird nicht mit dem
# Momentanwert, sondern mit dem 95. Perzentil der letzten 30 Tage: Der Wert
# schwankt im Tagesverlauf um mehrere Kilowattstunden, und BMW liefert nur
# ganze Zahlen - ein Schritt sind rund 1,2 Prozentpunkte.
#
# REINE VERBRENNER sind nicht betroffen: Dort streamt BMW maxEnergy nie, und
# dann entsteht keine Zeile - unabhaengig davon, was hier steht.
# BATTERY_NOMINAL_KWH=81.4

# --- Keba-Wallbox (optional) ---
# IP-Adresse einer Keba P30. Ohne diese Angabe passiert nichts: kein Socket,
# kein Hintergrund-Thread, keine Anzeige. Wer keine Keba hat, merkt vom
# Feature nichts.
#
# Die Wallbox misst dieselbe Ladung ein zweites Mal, an der Wand. Daraus
# entstehen zwei Aussagen: die Abweichung zu BMWs Angabe und - wichtiger -
# Ladungen, die BMWs Ladeverlauf gar nicht enthaelt.
#
# ZWEI VORAUSSETZUNGEN:
#
# 1. Der Container braucht den UDP-Port 7090. Die Wallbox antwortet
#    ausschliesslich dorthin, nicht an den Quellport. In docker-compose.yml
#    unter "ports" ergaenzen:
#        - "7090:7090/udp"
#    Bewusst nicht voreingestellt: Ist der Port auf dem Host belegt, startet
#    der Container sonst gar nicht mehr.
#
# 2. Die UDP-Schnittstelle der Keba darf laut Herstellerdoku NICHT gleichzeitig
#    mit Modbus TCP verwendet werden. Wer die Wallbox bereits ueber Modbus
#    anbindet (etwa aus einer Hausautomatisierung), kann UDP nicht zusaetzlich
#    nutzen.
#
# Ausserdem noetig: DIP-Schalter DSW1.3 auf ON, Firmware 3.9.24 oder neuer.
# KEBA_HOST=192.168.1.100

# Abweichender UDP-Port, falls noetig (Standard 7090).
# KEBA_PORT=7090

# Abstand zwischen zwei Abfragen in Minuten (Standard 15). Die Wallbox haelt
# nur die letzten 30 Ladesitzungen vor - wer sehr haeufig laedt, sollte den
# Wert senken, sonst fallen Sitzungen aus dem Puffer, bevor sie archiviert
# sind. Die Bridge meldet das im Protokoll, wenn es passiert.
# KEBA_POLL_MINUTES=15
